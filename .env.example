# Logging configuration
# LOG_LEVEL=INFO               # Logging level (e.g., DEBUG, INFO, ERROR)
# OUTPUT_DIR=logs              # Default directory for output files

# Database (durable storage). The schema auto-initializes on first connect.
# DB_HOST=localhost
# DB_NAME=webanalyzer
# DB_USER=root
# DB_PASSWORD=root
# DB_POOL_SIZE=20

# Public-demo guardrails (leave off for self-hosted / full-power use).
# When DEMO_MODE is enabled, scan endpoints are rate-limited per client and
# refuse to scan internal/private/reserved targets (SSRF protection).
# DEMO_MODE=false
# DEMO_RATE_LIMIT=10           # Max scan requests per client per window
# DEMO_RATE_WINDOW=600         # Rate-limit window in seconds

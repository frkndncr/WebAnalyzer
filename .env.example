# Logging configuration
# LOG_LEVEL=INFO               # Logging level (e.g., DEBUG, INFO, ERROR)
# OUTPUT_DIR=logs              # Default directory for output files

# Database (durable storage). The schema auto-initializes on first connect.
# DB_HOST=localhost
# DB_NAME=webanalyzer
# DB_USER=root
# DB_PASSWORD=root
# DB_POOL_SIZE=5              # Keep this below your database's connection limit (all are opened up front)
# DB_CONNECT_TIMEOUT=10        # Seconds to wait for a connection
# DB_RETRY_COOLDOWN=20         # After a failed connect, fail fast for this many seconds

# Public-demo guardrails (leave off for self-hosted / full-power use).
# When DEMO_MODE is enabled, scan endpoints are rate-limited per client and
# refuse to scan internal/private/reserved targets (SSRF protection).
# DEMO_MODE=false
# DEMO_RATE_LIMIT=10           # Max scan requests per client per window
# DEMO_RATE_WINDOW=600         # Rate-limit window in seconds

# With DEMO_MODE on, the intrusive modules (Nmap, active content tests, subdomain
# takeover probing, CloudFlare origin probing) only run on domains whose owner
# has published a DNS TXT record (see /api/verify/<domain>). Passive modules stay
# open. Optionally salt the per-domain token:
# VERIFY_SECRET=

# Optional: get a Telegram message when a scan starts and finishes (domain and counts only,
# never client IPs). Create a bot with @BotFather, then send it a message and read your chat id.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Also notify Slack and/or any https endpoint (JSON {event, text}) after each scan:
# SLACK_WEBHOOK_URL=
# WEBHOOK_URL=
